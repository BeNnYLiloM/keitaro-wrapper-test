# Ключ Admin API стенда: кнопка «API ключ» вверху на https://keitaro-for-tests.etolegko.com
KEITARO_API_KEY=

# Значения ниже уже выставлены по умолчанию — меняйте, только если нужно другое
# KEITARO_API_URL=https://keitaro-for-tests.etolegko.com/admin_api/v1
# KEITARO_ADMIN_URL=https://keitaro-for-tests.etolegko.com/admin
# KEITARO_DOMAIN_ID=1813
# KEITARO_GROUP_ID=10332
# KEITARO_TRAFFIC_SOURCE_ID=836
# GOOGLE_URL=https://google.com
# OFFERS_CACHE_TTL=600

# Для запуска без Docker (в docker-compose DATABASE_URL задаётся автоматически)
# DATABASE_URL=postgresql+asyncpg://keitaro:keitaro@localhost:5433/keitaro
